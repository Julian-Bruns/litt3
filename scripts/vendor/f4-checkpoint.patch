--- a/src/neogb/f4_hash_compact.h
+++ b/src/neogb/f4_hash_compact.h
@@ -0,0 +1,97 @@
+/* Round-boundary primary-hash garbage collection, exact untraced F5 LA2.
+ * No basis rows or pending pairs are removed. Hash IDs alone are renamed.
+ * Shared rn/dm/dv and the externally owned ht_t object remain in place. */
+static void f4cp_compact_hash(bs_t *b, md_t *m, const char *telemetry,
+        uint64_t *next_scan, int force) {
+    ht_t *h=b->ht;
+    const char *option=getenv("MSOLVE_F4_HASH_COMPACT");
+    if(option && !strcmp(option,"0")) return;
+    if(option && !strcmp(option,"force")) force=1;
+    if(!force && h->eld<*next_scan) return;
+    if(m->fc!=5 || m->laopt!=2 || m->use_signatures ||
+            m->trace_level!=NO_TRACER || m->ht->eld!=1 || b->lo!=b->ld)
+        f4cp_die("hash compaction requires an untraced empty-scratch round boundary");
+    double start=realtime();
+    const hl_t oldeld=h->eld, oldesz=h->esz;
+    hi_t *map=f4cp_alloc(oldeld,sizeof(*map));
+    for(bl_t i=0;i<b->ld;++i) {
+        hm_t *r=b->hm[i];
+        for(len_t j=0;j<r[LENGTH];++j) {
+            hi_t id=r[OFFSET+j];
+            if(!id || id>=oldeld) f4cp_die("invalid live polynomial hash");
+            map[id]=1;
+        }
+    }
+    for(pl_t i=0;i<m->ps->ld;++i) {
+        hi_t id=m->ps->p[i].lcm;
+        if(!id || id>=oldeld) f4cp_die("invalid live pair hash");
+        map[id]=1;
+    }
+    hl_t live=1, newelo=0;
+    for(hl_t i=1;i<oldeld;++i) if(map[i]) map[i]=(hi_t)live++;
+    /* elo is a boundary, not an individual monomial ID. Usually zero here. */
+    if(h->elo) {
+        newelo=1;
+        for(hl_t i=1;i<h->elo && i<oldeld;++i) if(map[i]) ++newelo;
+    }
+    hl_t capacity=4;
+    while(capacity<live+live/4+1) capacity*=2;
+    /* Scan again only after substantial new hash growth. Avoid scanning all
+     * polynomial terms merely because another small F4 batch completed. */
+    *next_scan=oldeld*2>UINT64_C(1048576)?oldeld*2:UINT64_C(1048576);
+    if(!force && oldeld-live<oldeld/4 && capacity>=oldesz/2) {
+        free(map); return;
+    }
+    if(capacity>oldesz) capacity=oldesz;
