+"""Exact whole-checkpoint hash-renaming comparison; does not run a solver.
+
+Memory maps both snapshots; auxiliary memory is one old-ID map plus a bitmap.
+Checks every polynomial term, coefficient byte, row header and queued pair,
+and exact exponent/hash metadata for every retained unique hash ID.
+"""
+import argparse, json, mmap, struct, time
+import numpy as np
+
+class Checkpoint:
+    def __init__(self, path):
+        self.file=open(path,'rb')
+        self.data=mmap.mmap(self.file.fileno(),0,access=mmap.ACCESS_READ)
+        self.pos=0
+        self.header=self.array(15,'<u8').copy()
+        names='ld sz lo constant mltdeg lml elo eld esz hsz ebl nv evl ndv bpv rsd'.split()
+        self.d=dict(zip(names,map(int,self.array(16,'<u8'))))
+        d=self.d
+        self.ev=self.array(d['eld']*d['evl'],'<u2').reshape(-1,d['evl'])
+        self.hd=self.array(d['eld']*4,'<u4').reshape(-1,4)
+        self.hmap=self.array(d['hsz'],'<u4')
+        self.shared=self.array(d['ndv']*d['bpv']+d['ndv']+d['evl'],'<u4')
+        self.red=self.array(d['ld'],'u1')
+        self.lm=self.array(d['lml'],'<u4')
+        self.lmps=self.array(d['lml'],'<u4')
+        self.rows=[]
+        for _ in range(d['ld']):
+            n=int(self.array(1,'<u8')[0])
+            prefix=self.array(int(self.header[7]),'<u4')
+            terms=self.array(n,'<u4')
+            coeffs=self.array(n*int(self.header[12])//8,'u1')
+            self.rows.append((prefix,terms,coeffs))
+        self.pld,self.psz=map(int,self.array(2,'<u8'))
+        self.pairs=self.array(self.pld*5,'<u8').reshape(-1,5)
+        self.tail=self.data[self.pos:-8]
+    def array(self,n,dtype):
+        result=np.frombuffer(self.data,dtype=dtype,count=n,offset=self.pos)
+        self.pos+=result.nbytes
+        return result
+
+def compare(oldpath,newpath,ignore_timings=False):
+    start=time.monotonic();a,b=Checkpoint(oldpath),Checkpoint(newpath)
+    eq=lambda x,y: np.array_equal(x,y)
+    assert eq(a.header,b.header),'header/input changed'
+    for k in a.d:
+        if k not in ('elo','eld','esz','hsz'): assert a.d[k]==b.d[k],k
+    for k in ('shared','red','lm','lmps'): assert eq(getattr(a,k),getattr(b,k)),k
+    atail=a.tail[:-32] if ignore_timings else a.tail
+    btail=b.tail[:-32] if ignore_timings else b.tail
+    assert (a.pld,a.psz,atail)==(b.pld,b.psz,btail),'queue capacity or progress changed'
+    used=np.zeros(a.d['eld'],dtype=np.bool_);used[0]=True
+    for _,terms,_ in a.rows: used[terms]=True
+    used[a.pairs[:,0]]=True
+    ids=np.flatnonzero(used)
+    assert len(ids)==b.d['eld'],'new table not exactly live hashes'
+    mapping=np.zeros(a.d['eld'],dtype='<u4')
+    mapping[ids]=np.arange(len(ids),dtype='<u4')
+    for j in range(0,len(ids),8192):
+        block=ids[j:j+8192]
+        assert eq(a.ev[block],b.ev[j:j+len(block)]),'exponents changed'
+        assert eq(a.hd[block],b.hd[j:j+len(block)]),'hash metadata changed'
+    nterms=0
+    for (ap,at,ac),(bp,bt,bc) in zip(a.rows,b.rows):
+        assert eq(ap,bp),'row metadata changed'
+        assert eq(ac,bc),'coefficients changed'
+        assert eq(mapping[at],bt),'polynomial terms changed'
+        nterms+=len(at)
+    assert eq(mapping[a.pairs[:,0]],b.pairs[:,0]),'pair LCM changed'
+    assert eq(a.pairs[:,1:],b.pairs[:,1:]),'pair endpoints/degree/type/order changed'
+    refs=set(map(int,a.lmps));refs.update(map(int,a.pairs[:,1]));refs.update(map(int,a.pairs[:,2]))
+    deadrows=[i for i in range(a.d['ld']) if a.red[i] and i not in refs]
+    return dict(old_path=oldpath,new_path=newpath,exact_equivalence=True,
+        timing_counters_ignored=ignore_timings,
+        round=struct.unpack_from('<Q',a.tail,8)[0],
+        old_dimensions=a.d,new_dimensions=b.d,all_terms_checked=nterms,
+        all_pairs_checked=a.pld,dead_basis_rows=len(deadrows),
+        old_bytes=len(a.data),new_bytes=len(b.data),
+        old_hash_capacity_bytes=a.d['esz']*(2*a.d['evl']+32),
+        new_hash_capacity_bytes=b.d['esz']*(2*b.d['evl']+32),
+        seconds=time.monotonic()-start)
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser();p.add_argument('old');p.add_argument('new')
+    p.add_argument('--output');p.add_argument('--ignore-timings',action='store_true')
+    args=p.parse_args()
+    result=compare(args.old,args.new,args.ignore_timings)
+    if args.output:
+        with open(args.output,'w') as f: json.dump(result,f,indent=2);f.write('\n')
+    print(json.dumps(result,indent=2))
