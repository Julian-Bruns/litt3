+"""Reproduce forced-compaction regression tests and optional large differential.
+
+python3 hash_compact_test.py --input /path/input.ms --checkpoint /path/state.cp
+Without arguments only the existing small regression suite runs.
+Large outputs stay in checkpoint-tests; the supplied checkpoint is never changed.
+"""
+import argparse, json, os, pathlib, subprocess
+from hash_compact_compare import compare
+
+p=argparse.ArgumentParser();p.add_argument('--input');p.add_argument('--checkpoint')
+args=p.parse_args();root=pathlib.Path(__file__).resolve().parent
+subprocess.run(['python3',str(root/'checkpoint_test.py')],
+    env={**os.environ,'MSOLVE_F4_HASH_COMPACT':'force'},check=True)
+if args.checkpoint:
+    assert args.input,'--input required with --checkpoint'
+    out=root/'checkpoint-tests'
+    def run(name,source,option,maintenance=False):
+        target=out/(name+'.cp')
+        env={**os.environ,'MSOLVE_F4_RESUME':str(source),
+            'MSOLVE_F4_CHECKPOINT':str(target),'MSOLVE_F4_HASH_COMPACT':option,
+            'MSOLVE_F4_TELEMETRY':str(out/(name+'.jsonl')),
+            'MSOLVE_F4_STOP_AFTER_ROUNDS':'1'}
+        if maintenance: env['MSOLVE_F4_COMPACT_ONLY']='1'
+        cmd=[str(root/'msolve'),'-f',args.input,'-o',str(out/(name+'.gb')),
+            '-g','2','-l','2','-t','10','-m','64','-c','0']
+        with open(out/(name+'.log'),'w') as f:
+            r=subprocess.run(cmd,env=env,stdout=f,stderr=subprocess.STDOUT)
+        assert r.returncode==75,(name,r.returncode)
+        return target
+    compact=run('hash-test-compact',args.checkpoint,'force',True)
+    first=compare(args.checkpoint,str(compact))
+    # Sequential runs deliberately avoid duplicating large resident bases.
+    baseline=run('hash-test-disabled',compact,'0')
+    collected=run('hash-test-forced',compact,'force')
+    # Timing counters differ after a real F4 round; compare's default is
+    # strict for maintenance snapshots, so use the explicit timing exception.
+    second=compare(str(baseline),str(collected),ignore_timings=True)
+    with open(out/'hash-test-results.json','w') as f:
+        json.dump(dict(maintenance=first,one_round=second),f,indent=2)
