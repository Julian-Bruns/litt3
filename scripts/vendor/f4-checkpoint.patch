--- a/src/neogb/f4_checkpoint.h
+++ b/src/neogb/f4_checkpoint.h
@@ -0,0 +1,220 @@
+/* Algorithmic round-boundary checkpoints for the exact, untraced F5 F4 path.
+ * Native-endian arrays, explicitly versioned and ABI checked. No pointers,
+ * matrices, thread state, or process images are persisted. */
+#include <signal.h>
+#include <unistd.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <fcntl.h>
+#include <sys/time.h>
+
+static volatile sig_atomic_t f4cp_requested;
+static void f4cp_signal(int sig) { (void)sig; f4cp_requested = 1; }
+static void f4cp_die(const char *s) {
+    fprintf(stderr, "F4_CHECKPOINT_ERROR: %s (%s)\n", s, strerror(errno));
+    exit(74);
+}
+static void *f4cp_alloc(size_t n, size_t z) {
+    if (z && n > SIZE_MAX/z) f4cp_die("allocation overflow");
+    void *p = calloc(n ? n : 1, z);
+    if (!p) f4cp_die("allocation");
+    return p;
+}
+static uint64_t f4cp_hash(uint64_t h, const void *p, size_t n) {
+    const unsigned char *q = p;
+    while (n--) { h ^= *q++; h *= UINT64_C(1099511628211); }
+    return h;
+}
+static void *f4cp_cf(bs_t *b, unsigned i, int bits) {
+    return bits == 8 ? (void *)b->cf_8[i] : bits == 16 ?
+        (void *)b->cf_16[i] : (void *)b->cf_32[i];
+}
+static uint64_t f4cp_input(bs_t *b, md_t *m) {
+    uint64_t h = UINT64_C(14695981039346656037);
+    h = f4cp_hash(h, &b->ld, sizeof(b->ld));
+    for (unsigned i=0; i<b->ld; ++i) {
+        hm_t *r = b->hm[i];
+        h = f4cp_hash(h, &r[LENGTH], sizeof(hm_t));
+        h = f4cp_hash(h, f4cp_cf(b,r[COEFFS],m->ff_bits),
+                (size_t)r[LENGTH]*(m->ff_bits/8));
+        for(unsigned j=0;j<r[LENGTH];++j)
+            h=f4cp_hash(h,b->ht->ev[r[OFFSET+j]],b->ht->evl*sizeof(exp_t));
+    }
+    return h;
+}
+typedef struct { FILE *f; uint64_t hash; int reading; } f4cp_io;
+static void f4cp_bytes(f4cp_io *s, void *p, size_t n) {
+    if ((s->reading ? fread(p,1,n,s->f) : fwrite(p,1,n,s->f)) != n)
+        f4cp_die("short checkpoint IO");
+    s->hash=f4cp_hash(s->hash,p,n);
+}
+static uint64_t f4cp_num(f4cp_io *s, uint64_t n) {
+    f4cp_bytes(s,&n,sizeof(n)); return n;
+}
+#define CP_SCALAR(o,f) ((o)->f=f4cp_num(s,(o)->f))
+#define CP_ARRAY(p,n) f4cp_bytes(s,(p),(size_t)(n)*sizeof(*(p)))
+static void f4cp_body(f4cp_io *s, bs_t *b, md_t *m) {
+    ht_t *h=b->ht;
+    CP_SCALAR(b,ld); CP_SCALAR(b,sz); CP_SCALAR(b,lo);
+    CP_SCALAR(b,constant); CP_SCALAR(b,mltdeg); CP_SCALAR(b,lml);
+    CP_SCALAR(h,elo); CP_SCALAR(h,eld); CP_SCALAR(h,esz);
+    CP_SCALAR(h,hsz); CP_SCALAR(h,ebl); CP_SCALAR(h,nv);
+    CP_SCALAR(h,evl); CP_SCALAR(h,ndv); CP_SCALAR(h,bpv); CP_SCALAR(h,rsd);
+    if (b->ld>b->sz || b->lml>b->ld || b->lo>b->ld || h->eld>h->esz ||
+        h->esz*2!=h->hsz || h->hsz<8 || (h->hsz&(h->hsz-1)) ||
+        h->nv!=(unsigned)m->nvars || h->ebl!=(unsigned)(m->nev?m->nev+1:0) ||
+        h->evl!=h->nv+1+(h->ebl!=0) || h->ndv>32 || h->ndv*h->bpv>32)
+        f4cp_die("invalid dimensions");
+    if (s->reading) {
+        b->hm=f4cp_alloc(b->sz,sizeof(*b->hm));
+        b->red=f4cp_alloc(b->sz,sizeof(*b->red));
+        b->lm=f4cp_alloc(b->sz,sizeof(*b->lm));
+        b->lmps=f4cp_alloc(b->sz,sizeof(*b->lmps));
+        if(m->ff_bits==8) b->cf_8=f4cp_alloc(b->sz,sizeof(*b->cf_8));
+        else if(m->ff_bits==16) b->cf_16=f4cp_alloc(b->sz,sizeof(*b->cf_16));
+        else b->cf_32=f4cp_alloc(b->sz,sizeof(*b->cf_32));
+        h->ev=f4cp_alloc(h->esz,sizeof(*h->ev));
+        h->ev[0]=f4cp_alloc(h->esz,h->evl*sizeof(exp_t));
+        for(hl_t i=1;i<h->esz;++i) h->ev[i]=h->ev[0]+i*h->evl;
+        h->hd=f4cp_alloc(h->esz,sizeof(*h->hd));
+        h->hmap=f4cp_alloc(h->hsz,sizeof(*h->hmap));
+        h->dm=f4cp_alloc(h->ndv*h->bpv,sizeof(*h->dm));
+        h->dv=f4cp_alloc(h->ndv,sizeof(*h->dv));
+        h->rn=f4cp_alloc(h->evl,sizeof(*h->rn));
+    }
+    CP_ARRAY(h->ev[0],h->eld*h->evl); CP_ARRAY(h->hd,h->eld);
+    CP_ARRAY(h->hmap,h->hsz); CP_ARRAY(h->dm,h->ndv*h->bpv);
+    CP_ARRAY(h->dv,h->ndv); CP_ARRAY(h->rn,h->evl);
+    CP_ARRAY(b->red,b->ld); CP_ARRAY(b->lm,b->lml); CP_ARRAY(b->lmps,b->lml);
+    for(unsigned i=0;i<b->ld;++i) {
+        uint64_t n=f4cp_num(s,s->reading?0:b->hm[i][LENGTH]);
+        if(!n || n>UINT32_MAX-OFFSET) f4cp_die("invalid polynomial size");
+        if(s->reading) b->hm[i]=f4cp_alloc(n+OFFSET,sizeof(hm_t));
+        CP_ARRAY(b->hm[i],n+OFFSET);
+        unsigned c=b->hm[i][COEFFS];
+        if(c>=b->ld || b->hm[i][LENGTH]!=n) f4cp_die("invalid coefficient index");
+        if(s->reading) {
+            if(f4cp_cf(b,c,m->ff_bits)) f4cp_die("duplicate coefficient index");
+            void *p=f4cp_alloc(n,m->ff_bits/8);
+            if(m->ff_bits==8) b->cf_8[c]=p;
+            else if(m->ff_bits==16) b->cf_16[c]=p; else b->cf_32[c]=p;
+        }
+        f4cp_bytes(s,f4cp_cf(b,c,m->ff_bits),n*(m->ff_bits/8));
+        for(unsigned j=0;j<n;++j)
+            if(b->hm[i][OFFSET+j]>=h->eld) f4cp_die("invalid monomial index");
+    }
+    CP_SCALAR(m->ps,ld); CP_SCALAR(m->ps,sz);
+    if(m->ps->ld>m->ps->sz) f4cp_die("invalid pair count");
+    if(s->reading) m->ps->p=f4cp_alloc(m->ps->sz,sizeof(spair_t));
+    /* Explicit fields: enum padding is not part of the format. */
+    for(unsigned i=0;i<m->ps->ld;++i) {
+        spair_t *p=m->ps->p+i;
+        CP_SCALAR(p,lcm); CP_SCALAR(p,gen1); CP_SCALAR(p,gen2);
+        CP_SCALAR(p,deg); CP_SCALAR(p,type);
+        if(p->lcm>=h->eld || p->gen1>=b->ld || p->gen2>=b->ld)
+            f4cp_die("invalid S-pair reference");
+    }
+    CP_SCALAR(m,np); CP_SCALAR(m,current_rd); CP_SCALAR(m,current_deg);
+    CP_SCALAR(m,homogeneous); CP_SCALAR(m,max_gb_degree);
+    CP_SCALAR(m,min_deg_in_first_deg_fall);
+    CP_SCALAR(m,num_pairsred); CP_SCALAR(m,num_gb_crit);
+    CP_SCALAR(m,num_redundant); CP_SCALAR(m,num_redundant_old);
+    CP_SCALAR(m,num_rowsred); CP_SCALAR(m,num_zerored); CP_SCALAR(m,num_rht);
+    CP_SCALAR(m,max_bht_size); CP_SCALAR(m,max_sht_size); CP_SCALAR(m,max_uht_size);
+    CP_ARRAY(&m->select_rtime,1); CP_ARRAY(&m->symbol_rtime,1);
+    CP_ARRAY(&m->la_rtime,1); CP_ARRAY(&m->update_rtime,1);
+}
+static void f4cp_header(f4cp_io *s, md_t *m, uint64_t input) {
+    uint64_t v[]={UINT64_C(0x41544c4153463443),1,0x01020304,
+        sizeof(exp_t),sizeof(hm_t),sizeof(hd_t),sizeof(double),OFFSET,
+        m->fc,m->nvars,m->mo,m->nev,m->ff_bits,m->laopt,input};
+    for(unsigned i=0;i<sizeof(v)/sizeof(*v);++i)
+        if(f4cp_num(s,v[i])!=v[i]) f4cp_die("header/input mismatch");
+}
+static void f4cp_save(const char *path, bs_t *b, md_t *m, uint64_t input) {
+    char *tmp=f4cp_alloc(strlen(path)+48,1), *prev=f4cp_alloc(strlen(path)+8,1);
+    sprintf(tmp,"%s.tmp.%ld",path,(long)getpid()); sprintf(prev,"%s.prev",path);
+    f4cp_io io={fopen(tmp,"wb"),UINT64_C(14695981039346656037),0};
+    if(!io.f) f4cp_die("open temporary checkpoint");
+    f4cp_header(&io,m,input); f4cp_body(&io,b,m);
+    if(fwrite(&io.hash,8,1,io.f)!=1 || fflush(io.f) || fsync(fileno(io.f)))
+        f4cp_die("sync checkpoint");
+    if(fclose(io.f)) f4cp_die("close checkpoint");
+    /* Hard-link the existing valid snapshot before atomic replacement. */
+    if(unlink(prev) && errno!=ENOENT) f4cp_die("unlink previous checkpoint link");
+    if(link(path,prev) && errno!=ENOENT) f4cp_die("retain previous checkpoint");
+    if(rename(tmp,path)) f4cp_die("promote checkpoint");
+    char *dir=f4cp_alloc(strlen(path)+2,1); strcpy(dir,path);
+    char *slash=strrchr(dir,'/');
+    if(slash) { if(slash==dir) slash[1]=0; else *slash=0; }
+    else strcpy(dir,".");
+    int dfd=open(dir,O_RDONLY);
+    if(dfd<0 || fsync(dfd)) f4cp_die("sync checkpoint directory");
+    close(dfd); free(dir);
+    fprintf(stderr,"F4_CHECKPOINT_SAVED round=%d pairs=%u path=%s\n",m->current_rd,m->ps->ld,path);
+    free(tmp); free(prev);
+}
+static void f4cp_load(const char *path, bs_t *b, md_t *m, uint64_t input) {
+    f4cp_io io={fopen(path,"rb"),UINT64_C(14695981039346656037),1};
+    if(!io.f) f4cp_die("open checkpoint");
+    /* Verify the entire checksum BEFORE trusting allocation dimensions. */
+    if(fseek(io.f,0,SEEK_END)) f4cp_die("seek");
+    long length=ftell(io.f); if(length<128) f4cp_die("short checkpoint");
+    rewind(io.f); unsigned char buf[65536]; uint64_t h=io.hash, stored;
+    for(long left=length-8;left>0;) {
+        size_t n=left>(long)sizeof(buf)?sizeof(buf):(size_t)left;
+        if(fread(buf,1,n,io.f)!=n) f4cp_die("read integrity pass");
+        h=f4cp_hash(h,buf,n); left-=n;
+    }
+    if(fread(&stored,8,1,io.f)!=1 || stored!=h) f4cp_die("checksum mismatch");
+    rewind(io.f); f4cp_header(&io,m,input);
+    bs_t *nb=f4cp_alloc(1,sizeof(*nb)); nb->ht=f4cp_alloc(1,sizeof(ht_t));
+    md_t nm=*m; nm.ps=f4cp_alloc(1,sizeof(ps_t));
+    f4cp_body(&io,nb,&nm);
+    if(ftell(io.f)!=length-8 || io.hash!=stored) f4cp_die("checkpoint trailing data");
+    fclose(io.f);
+    free_hash_table(&m->ht); free_pairset(&m->ps);
+    /* Retain the externally owned bs and basis-hash object addresses. */
+    ht_t *oldh=b->ht;
+    free_shared_hash_data(oldh); free(oldh->hmap); free(oldh->hd);
+    free(oldh->ev[0]); free(oldh->ev);
+    *oldh=*nb->ht; free(nb->ht); nb->ht=oldh;
+    bs_t *oldb=f4cp_alloc(1,sizeof(*oldb)); *oldb=*b;
+    free_basis_without_hash_table(&oldb); *b=*nb; free(nb);
+    *m=nm; m->ht=initialize_secondary_hash_table(b->ht,m);
+    fprintf(stderr,"F4_CHECKPOINT_RESUMED round=%d pairs=%u path=%s\n",m->current_rd,m->ps->ld,path);
+}
+static int f4cp_degcmp(const void *a,const void *b) {
+    deg_t x=*(const deg_t *)a,y=*(const deg_t *)b; return (x>y)-(x<y);
+}
+static double f4cp_unix_time(void) {
+    struct timeval t; gettimeofday(&t,NULL); return t.tv_sec+t.tv_usec*1e-6;
+}
+static void f4cp_pre_la(const char *path,bs_t *b,md_t *m,
+        uint64_t rows,uint64_t cols,uint64_t nnz) {
+    if(!path) return;
+    FILE *f=fopen(path,"a"); if(!f) f4cp_die("telemetry open");
+    fprintf(f,"{\"event\":\"pre_la\",\"unix_seconds\":%.6f,\"round\":%d,\"degree\":%d,\"rows\":%"PRIu64",\"cols\":%"PRIu64",\"nnz\":%"PRIu64",\"basis_count\":%u,\"pending_pairs\":%u}\n",
+        f4cp_unix_time(),m->current_rd+1,m->current_deg,rows,cols,nnz,b->ld,m->ps->ld);
+    if(fclose(f)) f4cp_die("telemetry close");
+}
+static void f4cp_telemetry(const char *path,bs_t *b,md_t *m,
+        uint64_t rows,uint64_t cols,uint64_t nnz,uint64_t before,
+        uint64_t selected,double *t,double roundtime) {
+    if(!path) return;
+    FILE *f=fopen(path,"a"); if(!f) f4cp_die("telemetry open");
+    deg_t *d=f4cp_alloc(m->ps->ld,sizeof(deg_t));
+    for(unsigned i=0;i<m->ps->ld;++i) d[i]=m->ps->p[i].deg;
+    qsort(d,m->ps->ld,sizeof(*d),f4cp_degcmp);
+    fprintf(f,"{\"event\":\"round\",\"round\":%d,\"degree\":%d,\"pending_pairs\":%u,\"current_degree_pairs_before\":%"PRIu64",\"selected_pairs\":%"PRIu64",\"rows\":%"PRIu64",\"cols\":%"PRIu64",\"nnz\":%"PRIu64",\"new_pivots\":%u,\"basis_count\":%u,\"select_seconds\":%.9g,\"symbol_seconds\":%.9g,\"la_seconds\":%.9g,\"update_seconds\":%.9g,\"round_seconds\":%.9g,\"pending_by_degree\":{",
+        m->current_rd,m->current_deg,m->ps->ld,before,selected,rows,cols,nnz,
+        m->np,b->ld,m->select_rtime-t[0],m->symbol_rtime-t[1],
+        m->la_rtime-t[2],m->update_rtime-t[3],roundtime);
+    for(unsigned i=0;i<m->ps->ld;) {
+        unsigned j=i+1;while(j<m->ps->ld&&d[j]==d[i])++j;
+        fprintf(f,"%s\"%d\":%u",i?",":"",d[i],j-i);i=j;
+    }
+    fprintf(f,"},\"unix_seconds\":%.6f}\n",f4cp_unix_time());free(d);if(fclose(f)) f4cp_die("telemetry close");
+}
