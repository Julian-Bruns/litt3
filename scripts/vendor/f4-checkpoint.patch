+    exp_t *exps=f4cp_alloc(capacity,h->evl*sizeof(*exps));
+    hd_t *hd=f4cp_alloc(capacity,sizeof(*hd));
+    hi_t *hmap=f4cp_alloc(capacity*2,sizeof(*hmap));
+    for(hl_t i=0;i<capacity;++i) ev[i]=exps+i*h->evl;
+    memcpy(ev[0],h->ev[0],h->evl*sizeof(exp_t));
+    hd[0]=h->hd[0];
+    const hi_t mask=(hi_t)(capacity*2-1);
+    for(hl_t i=1;i<oldeld;++i) if(map[i]) {
+        hi_t id=map[i];
+        memcpy(ev[id],h->ev[i],h->evl*sizeof(exp_t));
+        hd[id]=h->hd[i];
+        /* Same triangular probing as insert_in_hash_table(). */
+        hi_t k=hd[id].val;
+        hl_t probe=0;
+        do { k=(hi_t)((k+probe)&mask); ++probe; } while(hmap[k]);
+        hmap[k]=id;
+    }
+    /* Validate unique-entry exponent/metadata preservation and lookup before
+     * changing any basis or pair references. This is exact byte comparison. */
+    ht_t nh=*h; nh.ev=ev; nh.hd=hd; nh.hmap=hmap;
+    nh.eld=live; nh.esz=capacity; nh.hsz=capacity*2; nh.elo=newelo;
+    for(hl_t i=1;i<oldeld;++i) if(map[i]) {
+        hi_t id=map[i], found=0;
+        if(memcmp(h->ev[i],ev[id],h->evl*sizeof(exp_t)) ||
+                memcmp(h->hd+i,hd+id,sizeof(hd_t)) ||
+                is_contained_in_hash_table(ev[id],&nh,hd[id].val,&found)!=1 ||
+                found!=id) f4cp_die("compacted hash equivalence check failed");
+    }
+    for(bl_t i=0;i<b->ld;++i) {
+        hm_t *r=b->hm[i];
+        for(len_t j=0;j<r[LENGTH];++j) r[OFFSET+j]=map[r[OFFSET+j]];
+    }
+    for(pl_t i=0;i<m->ps->ld;++i) m->ps->p[i].lcm=map[m->ps->p[i].lcm];
+    free(h->ev[0]); free(h->ev); free(h->hd); free(h->hmap);
+    *h=nh; free(map);
+    *next_scan=live*2>UINT64_C(1048576)?live*2:UINT64_C(1048576);
+    double seconds=realtime()-start;
+    fprintf(stderr,"F4_HASH_COMPACT round=%d eld=%"PRIu64"->%"PRIu64
+            " esz=%"PRIu64"->%"PRIu64" seconds=%.6f\n",
+            m->current_rd,(uint64_t)oldeld,(uint64_t)live,
+            (uint64_t)oldesz,(uint64_t)capacity,seconds);
+    if(telemetry) {
+        FILE *f=fopen(telemetry,"a"); if(!f) f4cp_die("compact telemetry open");
+        fprintf(f,"{\"event\":\"hash_compact\",\"round\":%d,\"degree\":%d,\"unix_seconds\":%.6f,"
+                "\"old_eld\":%"PRIu64",\"new_eld\":%"PRIu64",\"old_esz\":%"PRIu64
+                ",\"new_esz\":%"PRIu64",\"live_count\":%"PRIu64",\"seconds\":%.9g}\n",
+                m->current_rd,m->current_deg,f4cp_unix_time(),(uint64_t)oldeld,(uint64_t)live,
+                (uint64_t)oldesz,(uint64_t)capacity,(uint64_t)live,seconds);
+        if(fclose(f)) f4cp_die("compact telemetry close");
+    }
+}
